{
  "name": "@guidelight/quran",
  "version": "0.1.2",
  "private": true,
  "description": "Indonesian Quran corpus (Kemenag text and translation via EQuran.id) with the Standar Mushaf Indonesia juz table and passage helpers, no UI",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ayahs": {
      "types": "./dist/ayahs.d.ts",
      "import": "./dist/ayahs.js",
      "default": "./dist/ayahs.js"
    },
    "./provenance": "./dist/data/provenance.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "CORPUS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "import": "node scripts/import-corpus.mjs",
    "import:write": "node scripts/import-corpus.mjs --write",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuidelightID/khazanah.git",
    "directory": "packages/quran"
  },
  "keywords": [
    "quran",
    "kemenag",
    "equran",
    "juz",
    "indonesia"
  ]
}
