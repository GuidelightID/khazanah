{
  "name": "@guidelightid/mushaf-corpus",
  "version": "0.1.0",
  "description": "Korpus Al-Qur'an Indonesia (equran.id / Kemenag) beserta peta juz Standar Mushaf Indonesia dan utilitas rentang ayat — tanpa tampilan",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ayahs": {
      "types": "./dist/ayahs.d.ts",
      "import": "./dist/ayahs.js",
      "default": "./dist/ayahs.js"
    },
    "./provenance": "./dist/data/provenance.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CORPUS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "import": "node scripts/import-corpus.mjs",
    "import:write": "node scripts/import-corpus.mjs --write",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuidelightID/mushaf.git",
    "directory": "packages/mushaf-corpus"
  },
  "keywords": [
    "quran",
    "kemenag",
    "equran",
    "juz",
    "indonesia"
  ]
}
