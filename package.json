{
  "name": "mushaf",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Layout-faithful Madinah Mushaf renderer for React & Next.js",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuidelightID/mushaf.git"
  },
  "bugs": {
    "url": "https://github.com/GuidelightID/mushaf/issues"
  },
  "homepage": "https://github.com/GuidelightID/mushaf#readme",
  "keywords": [
    "quran",
    "mushaf",
    "react",
    "nextjs",
    "arabic",
    "renderer"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @mushaf/core build && pnpm --filter @mushaf/renderer build && playwright test",
    "test:e2e:update": "pnpm --filter @mushaf/core build && pnpm --filter @mushaf/renderer build && playwright test --update-snapshots",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "size": "size-limit"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@playwright/test": "^1.49.1",
    "@size-limit/file": "^11.1.6",
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "size-limit": "^11.1.6",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
